rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && myData().admin == true;
    }

    // Operative = verified, not banned, ranked above Recruit. Comms access.
    function isOperative() {
      return request.auth != null
        && myData().verified == true
        && myData().banned != true
        && myData().rank != "Recruit";
    }

    function shadowActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/shadowStatus/$(request.auth.uid))
        && get(/databases/$(database)/documents/shadowStatus/$(request.auth.uid)).data.status == "active";
    }

    // Head of Shadow Division: may accept, promote, and remove operatives.
    function isShadowHead() {
      return shadowActive()
        && get(/databases/$(database)/documents/shadowStatus/$(request.auth.uid)).data.srank == "head";
    }

    // Who may see the real identity behind masked ??? messages.
    function canUnmask() {
      return isAdmin()
        || myData().rank == "Head of Solo Operations"
        || shadowActive();
    }

    match /users/{uid} {
      // Own profile, admins, and any operative (needed for rosters/comms).
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isOperative());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.admin == false
        && request.resource.data.banned == false
        && request.resource.data.rank == "Recruit";

      allow update, delete: if isAdmin();
    }

    // Shadow Division membership + division rank. Doc id = member uid,
    // fields: status ("none"|"aware"|"active"), srank ("operative"|"elite"|
    // "blackops"|"head"). The Head of Shadow Division manages the roster,
    // but cannot change their own doc (no self-promotion or self-protection).
    match /shadowStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isShadowHead());
      allow write: if isAdmin() || (isShadowHead() && request.auth.uid != uid);
    }

    function isEliteSoloCommander() {
      return isOperative() && myData().rank == "Elite Solo Commander";
    }

    // Secret division membership. Each member can read only their own doc.
    match /medicalStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Heavy Division: Elite Solo Commanders hold recruitment authority.
    match /heavyStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isEliteSoloCommander());
      allow write: if isAdmin() || isEliteSoloCommander();
    }

    match /corporateStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /justiceStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Medical Division applications: Elite Solo Commanders only.
    match /medicalRequests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isEliteSoloCommander() && request.auth.uid == uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Real identities behind masked chat messages. Only the Head of ETOG,
    // the Head of Solo Operations, and Shadow Operatives can read these.
    match /unmask/{id} {
      allow read: if isOperative() && canUnmask();
      allow create: if isOperative() && shadowActive()
        && request.resource.data.uid == request.auth.uid;
    }

    // Requests to DM the Head. Doc id = requester uid.
    match /dmRequests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isOperative() && request.auth.uid == uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    match /chats/{chatId} {

      function amMember() { return request.auth.uid in resource.data.members; }
      function amInvited() { return request.auth.uid in resource.data.invited; }
      function amOwner() { return resource.data.owner == request.auth.uid; }
      function sameRankChat() {
        return resource.data.type == "rank" && resource.data.rank == myData().rank;
      }
      function canDirectDm() {
        return isAdmin()
          || myData().rank == "Head of Grouped Operations"
          || myData().rank == "Head of Solo Operations"
          || shadowActive();
      }
      function dmRequestAccepted() {
        return exists(/databases/$(database)/documents/dmRequests/$(request.auth.uid))
          && get(/databases/$(database)/documents/dmRequests/$(request.auth.uid)).data.status == "accepted";
      }

      allow read: if isOperative() && (isAdmin() || sameRankChat() || amMember() || amInvited());

      allow create: if isOperative() && (
        // rank chat: only for your own rank
        (request.resource.data.type == "rank"
          && request.resource.data.rank == myData().rank)
        // group: you must be the owner and a member
        || (request.resource.data.type == "group"
          && request.resource.data.owner == request.auth.uid
          && request.auth.uid in request.resource.data.members)
        // dm: two people incl. you, and you're privileged or accepted
        || (request.resource.data.type == "dm"
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == 2
          && (canDirectDm() || dmRequestAccepted()))
      );

      // Owner manages the group; invited members accept/decline; members
      // and rank-mates may touch chat metadata; admin always.
      allow update: if isOperative()
        && (isAdmin() || amOwner() || amMember() || amInvited() || sameRankChat());

      allow delete: if isAdmin() || (isOperative() && amOwner());

      match /messages/{msgId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isOperative() && (
          isAdmin()
          || (chat().type == "rank" && chat().rank == myData().rank)
          || request.auth.uid in chat().members
        );
        allow create: if isOperative()
          && (request.resource.data.uid == request.auth.uid
            || (request.resource.data.uid == "masked" && shadowActive()))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (
            (chat().type == "rank" && chat().rank == myData().rank)
            || request.auth.uid in chat().members
          );
      }
    }
  }
}
